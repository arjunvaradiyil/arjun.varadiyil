# Set to true to show maintenance screen on home (no nav links or CTAs)
MAINTENANCE_MODE=false

# Resend (contact form)
RESEND_API_KEY=

# Payload CMS (site works without these — uses static data in src/data/)
PAYLOAD_SECRET=your-long-random-secret-here
DATABASE_URI=mongodb://127.0.0.1:27017/portfolio
# Set to false to skip CMS on the frontend (static fallback only)
# CMS_ENABLED=false

# Site URL — MUST match how you open the site (admin + media URLs)
# Local dev:
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Production (Vercel/hosting env vars — not in committed .env):
# NEXT_PUBLIC_SERVER_URL=https://arjunvaradiyil.in

# Optional extra Payload admin origins (comma-separated)
# PAYLOAD_CORS_ORIGINS=https://preview.example.com

# AWS S3 (Payload Media uploads)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional folder prefix inside the bucket
AWS_S3_PREFIX=portfolio/media
#
# Required on the S3 bucket for admin uploads (CORS → Allowed origins):
#   http://localhost:3000
#   https://arjunvaradiyil.in
# Allowed methods: GET, PUT, HEAD. Allowed headers: *

# Optional: first admin (only used by seed:create-admin)
# PAYLOAD_ADMIN_EMAIL=you@example.com
# PAYLOAD_ADMIN_PASSWORD=

# Optional: Google Analytics 4 (enables gtag on the public site)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: AI portfolio chat assistant (OpenAI-compatible)
# Without a key, the chat still answers from built-in offline FAQ replies.
# Free options when OpenAI quota is exhausted:
#
# Groq (recommended free): https://console.groq.com/keys
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_CHAT_MODEL=llama-3.3-70b-versatile
#
# Google Gemini: https://aistudio.google.com/apikey
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_CHAT_MODEL=gemini-2.0-flash
#
# OpenRouter free models: https://openrouter.ai/keys
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
